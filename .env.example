# Copie este arquivo para .env (mesma pasta) e preencha com os dados reais
# do seu banco no Neon: painel do Neon > seu projeto > Connection Details.
#
# IMPORTANTE:
# - O nome do arquivo deve ser exatamente ".env" (sem ".example") para o run.ps1 encontrar.
# - DB_URL precisa ser a string JDBC completa, com "?sslmode=require" no final.
# - Nunca compartilhe ou commite o arquivo .env com valores reais.

DB_URL=jdbc:postgresql://SEU-HOST-AQUI.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=sua_senha_aqui
JWT_SECRET=troque-por-uma-chave-bem-longa-e-aleatoria
CORS_ORIGIN=http://localhost:5173
